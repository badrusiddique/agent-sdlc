{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "TableStorage": {
    "Provider": "Memory",
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "BlobStorage": {
    "Provider": "File",
    "FileRootPath": "/tmp/bgx-poc-blobs",
    "ContainerName": "agenthub-artifacts"
  },
  "ServiceBus": {
    "ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true",
    "EnableConsumer": false
  },
  "Llm": {
    "Provider": "Fixture"
  },
  "Workers": {
    "Healthy": {
      "Enabled": false
    },
    "Pipeline": {
      "Enabled": true,
      "InProcessOnly": true
    }
  }
}
