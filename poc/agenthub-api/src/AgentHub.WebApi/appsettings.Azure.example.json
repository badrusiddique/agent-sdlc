{
  "_comment": "Copy values into env vars or user-secrets. Do not commit real secrets. Hybrid OK (e.g. Azurite + AzDO).",
  "TableStorage": {
    "Provider": "Azure",
    "ConnectionString": "<STORAGE_CONNECTION_STRING or UseDevelopmentStorage=true for Azurite>",
    "ServiceUri": ""
  },
  "BlobStorage": {
    "Provider": "Azure",
    "ConnectionString": "<STORAGE_CONNECTION_STRING or UseDevelopmentStorage=true for Azurite>",
    "ServiceUri": "",
    "ContainerName": "agenthub-artifacts"
  },
  "Ia": {
    "Git": {
      "Provider": "azuredevops",
      "Organization": "wcbbc",
      "Project": "AI-Operations",
      "Owner": "AI-Operations",
      "Repo": "inno-tech-aisdlc-apps",
      "Token": "<set via IA_GIT_TOKEN env — never commit>",
      "TargetBranch": "main",
      "ApiVersion": "7.1"
    },
    "Deploy": {
      "Provider": "appservice",
      "AppName": "<your-backend-app-name>",
      "PublicBaseUrl": "https://<your-backend-app-name>.azurewebsites.net",
      "ScmBaseUrl": "https://<your-backend-app-name>.scm.azurewebsites.net",
      "PublishUser": "<from publish profile — or IA_DEPLOY_USER>",
      "PublishPassword": "<from publish profile — or IA_DEPLOY_PASSWORD>",
      "HealthPath": "/health",
      "HealthTimeoutSeconds": 180
    }
  },
  "Llm": {
    "Provider": "Gateway",
    "Gateway": {
      "ChatEndpoint": "https://cc-sb-ts-aigw-apim.azure-api.net/ai/chat/completions",
      "DefaultModelAlias": "openai",
      "SubscriptionKey": "<env AIGW_SUBSCRIPTION_KEY>"
    }
  }
}
