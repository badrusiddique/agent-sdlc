{
  "_comment": "Copy values into env vars or user-secrets. Do not commit real secrets. Hybrid OK (e.g. Azurite + AzDO). Local laptop pointing at Azure = keys/PAT/publishProfile. AgentHub hosted on App Service = managedIdentity + ServiceUri.",
  "TableStorage": {
    "Provider": "Azure",
    "ConnectionString": "<local: STORAGE_CONNECTION_STRING or UseDevelopmentStorage=true>",
    "ServiceUri": "<cloud: https://<account>.table.core.windows.net — leave ConnectionString empty>"
  },
  "BlobStorage": {
    "Provider": "Azure",
    "ConnectionString": "<local: STORAGE_CONNECTION_STRING or UseDevelopmentStorage=true>",
    "ServiceUri": "<cloud: https://<account>.blob.core.windows.net — leave ConnectionString empty>",
    "ContainerName": "agenthub-artifacts"
  },
  "Ia": {
    "Git": {
      "Provider": "azuredevops",
      "Auth": "pat",
      "_authCloud": "managedIdentity",
      "Organization": "wcbbc",
      "Project": "AI-Operations",
      "Owner": "AI-Operations",
      "Repo": "inno-tech-aisdlc-apps",
      "Token": "<Auth=pat only — set via IA_GIT_TOKEN env — never commit>",
      "TargetBranch": "main",
      "ApiVersion": "7.1"
    },
    "Deploy": {
      "Provider": "appservice",
      "Auth": "publishProfile",
      "_authCloud": "managedIdentity",
      "AppName": "<your-backend-app-name>",
      "PublicBaseUrl": "https://<your-backend-app-name>.azurewebsites.net",
      "ScmBaseUrl": "https://<your-backend-app-name>.scm.azurewebsites.net",
      "PublishUser": "<Auth=publishProfile only — or IA_DEPLOY_USER>",
      "PublishPassword": "<Auth=publishProfile only — or IA_DEPLOY_PASSWORD>",
      "HealthPath": "/health",
      "HealthTimeoutSeconds": 180
    }
  },
  "Llm": {
    "Provider": "Gateway",
    "Gateway": {
      "ChatEndpoint": "https://cc-sb-ts-aigw-apim.azure-api.net/ai/chat/completions",
      "DefaultModelAlias": "openai",
      "SubscriptionKey": "<env AIGW_SUBSCRIPTION_KEY>"
    }
  }
}
