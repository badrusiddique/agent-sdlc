<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentHub.Agents.Healthy</RootNamespace>
    <Description>Host-agnostic HEALTHY dummy agent (Functions-ready). WebApi hosts the worker only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentHub.Data\AgentHub.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Prompts\healthy-system.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Prompts\healthy-system.txt" />
  </ItemGroup>

</Project>
