<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentHub.Agents.Healthy</RootNamespace>
    <Description>HEALTHY harness agent (Functions-ready). Depends on AgentHub.Core only — not Data or host types.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentHub.Core\AgentHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Prompts\healthy-system.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Prompts\healthy-system.txt" />
  </ItemGroup>

</Project>
